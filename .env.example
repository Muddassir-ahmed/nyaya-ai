APP_NAME=NyayaAI
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Local PostgreSQL started by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://nyaya_user:nyaya_password@localhost:5432/nyaya
TEST_DATABASE_URL=postgresql+asyncpg://nyaya_user:nyaya_password@localhost:5432/nyaya_test

# Replace this development-only value before any shared deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local Ollama inference.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=30m
PRELOAD_INFERENCE_MODELS=true

# Local semantic reranking.
RERANKER_PROVIDER=semantic
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_SIZE=1000000
